{
  "name": "@mdts/vite-plugin",
  "version": "0.0.0",
  "description": "Vite plugin for TypeScript Markdown documents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/totto2727-org/mdts.git",
    "directory": "packages/vite-plugin-mdts"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.d.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./client": "./dist/client.d.ts"
    },
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "confbox": "0.2.4",
    "effect": "catalog:",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "vite": "catalog:"
  },
  "peerDependencies": {
    "vite": "^0.2.8"
  },
  "engines": {
    "node": ">=24"
  }
}
