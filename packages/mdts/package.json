{
  "name": "@mdts/cli",
  "version": "0.1.0",
  "description": "TypeScript Markdown CLI and authoring API",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/totto2727-org/mdts.git",
    "directory": "packages/mdts"
  },
  "bin": {
    "mdts": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/config.d.mts",
      "import": "./dist/config.mjs"
    },
    "./client": "./dist/client.d.ts",
    "./comark": {
      "types": "./dist/comark.d.mts",
      "import": "./dist/comark.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "dependencies": {
    "@comark/html": "0.6.2",
    "@mdts/vite-plugin": "workspace:*",
    "@textlint/kernel": "15.8.0",
    "@textlint/module-interop": "15.8.0",
    "@textlint/textlint-plugin-markdown": "15.8.0",
    "beautiful-mermaid": "1.1.3",
    "effect": "catalog:",
    "github-markdown-css": "5.9.0",
    "katex": "0.17.0",
    "knip": "6.33.0",
    "markdownlint": "0.41.1",
    "shiki": "4.4.3",
    "slopless": "0.2.36",
    "textlint": "15.8.0",
    "textlint-rule-preset-ja-technical-writing": "12.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0-beta.65",
    "@types/node": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
